{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PROJECT_DIR}/scripts/private_references.py\" --tool-call",
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "^mcp__github__",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"${CLAUDE_PROJECT_DIR}/scripts/private_references.py\" --tool-call",
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
