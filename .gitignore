    ##################
# Compiled files #
##################
*.class

##################
# intellij files #
##################
*.iws
*.iml
*.ipr
.idea/**
.idea/*.*
# share these project-level settings so a fresh checkout gets a working IDE setup without
# needing to rediscover module/JDK/run-config quirks by hand; workspace.xml stays ignored,
# it's per-user session state (window layout, recently opened files, ...), not shared config
!.idea/runConfigurations
!.idea/compiler.xml
!.idea/gradle.xml
!.idea/misc.xml
!.idea/modules.xml
!.idea/vcs.xml
!.idea/modules
!.idea/modules/*.iml

#################
# eclipse files #
#################
/.project
/.classpath
/.settings
/.tern-project

#########################
# maven generated files #
#########################
/target

#############
# Zip files #
#############
*.tar
*.zip
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar

##############
# Logs files #
##############
*.log

#################
# test-ng files #
#################
/test-output

############################
# Binaries generated files #
############################
/bin

################
# gradle files #
################
/build
/.gradle
/gradle
/out
# standalone example projects under examples/ (e.g. the hello-plugin template) have their own
# independent Gradle builds - ignore their build output/cache too, only source should be tracked
examples/*/build/
examples/*/.gradle/
# Ignore Gradle GUI config
gradle-app.setting
# Avoid ignoring Gradle wrapper jar file (.jar files are usually ignored)
!/gradle/wrapper/gradle-wrapper.jar
!/gradle/wrapper/gradle-wrapper.properties
# Cache of project
.gradletasknamecache
# # Work around https://youtrack.jetbrains.com/issue/IDEA-116898
# gradle/wrapper/gradle-wrapper.properties

##############################################################
# virtual machine crash logs                                 #
# see http://www.java.com/en/download/help/error_hotspot.xml #
##############################################################
hs_err_pid*
/.attach_pid*
