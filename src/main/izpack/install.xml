<izpack:installation xmlns:izpack="http://izpack.org/schema/installation"
					 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
					 version="5.0"
					 xsi:schemaLocation="http://izpack.org/schema/installation http://izpack.org/schema/5.0/izpack-installation-5.0.xsd">
	<variables>
		<variable name="appGroup" value="@{app.group}"/>
		<variable name="appTitle" value="@{app.title}"/>
		<variable name="appName" value="@{app.name}"/>
		<variable name="appSubPath" value="@{app.subpath}"/>
		<variable name="appVersion" value="@{app.version}"/>
		<variable name="RESOURCEROOT" value="src/main/izpack" />
		<!-- pre-select desktop shortcut checkbox -->
		<variable name="DesktopShortcutCheckboxEnabled" value="true" />
	</variables>

	<info>
		<javaversion>@{app.java.version}</javaversion>
		<appname>@{app.name}</appname>
		<appsubpath>app/@{app.name}</appsubpath>
		<appversion>@{app.version}</appversion>
		<authors>
			<author name="@{app.author}" email="@{app.author.email}" />
		</authors>
		<url>@{app.url}</url>
	</info>

	<locale>
		<langpack iso3="eng" />
	</locale>

	<guiprefs width="800" height="600" resizable="no">
		<splash>images/peas_load.gif</splash>
		<laf name="kunststoff">
			<os family="windows" />
			<os family="unix" />
			<param name="variant" value="mist-silver" />
		</laf>
		<laf name="kunststoff">
			<os family="mac" />
			<param name="variant" value="mist-aqua" />
		</laf>
		<modifier key="useHeadingPanel" value="yes" />
	</guiprefs>

	<resources>
		<res src="../README.md" id="HTMLInfoPanel.info" />
		<res src="../LICENSE" id="LicencePanel.licence" />
		<res src="resources/main/img/icon.png" id="installer.langsel.img" />
	</resources>

	<panels>		
		<panel classname="HelloPanel"/>
		<panel classname="HTMLInfoPanel"/>
		<panel classname="LicencePanel"/>
		<panel classname="TargetPanel"/>
		<panel classname="PacksPanel"/>
		<panel classname="InstallPanel"/>
		<panel classname="SimpleFinishPanel"/>
	</panels>

	<packs>
		<pack name="executables" required="yes">
			<description>The executables</description>
			<file src="../CHANGELOG.md" targetdir="${INSTALL_PATH}" />
			<file src="../LICENSE" targetdir="${INSTALL_PATH}" />
			<singlefile src="signed/@{app.name}-@{app.version}-all.jar" target="${INSTALL_PATH}/@{app.name}.jar" />
			<file src="../README.md" targetdir="${INSTALL_PATH}" />
			<file src="resources/main/doc/@{app.name}.desktop" targetdir="${INSTALL_PATH}" />
			<!--
				Register the application with the desktop environment. A desktop entry is only picked up
				from the applications directory, and the Desktop Entry specification does not expand "~",
				so Exec and Icon have to carry the real installation path - which is what the parsable
				declarations below substitute into ${INSTALL_PATH}. The launcher also has to be readable
				and executable for the desktop to offer it.
			-->
			<singlefile src="resources/main/doc/@{app.name}.desktop"
						target="${USER_HOME}/.local/share/applications/@{app.name}.desktop" />
			<parsable targetfile="${INSTALL_PATH}/@{app.name}.desktop" type="plain" encoding="UTF-8" />
			<parsable targetfile="${USER_HOME}/.local/share/applications/@{app.name}.desktop"
					  type="plain" encoding="UTF-8" />
			<executable targetfile="${USER_HOME}/.local/share/applications/@{app.name}.desktop"
						stage="never" keep="true" />
			<executable targetfile="${INSTALL_PATH}/start.sh" stage="never" keep="true" />
			<file src="resources/main/doc/start.sh" targetdir="${INSTALL_PATH}" />
			<file src="resources/main/doc/start.bat" targetdir="${INSTALL_PATH}" />
			<file src="resources/main/img/icon.png" targetdir="${INSTALL_PATH}/img" />
		</pack>
		<!--
			The command-line interface ships as launcher scripts that run the CLI entry point from the
			same application jar (it bundles the mystic-crypt library which carries the CLI). Requires
			the application jar from the "executables" pack. Note: functional once this app depends on
			a mystic-crypt release that includes the CLI (io.github.astrapi69.mystic.crypt.cli).
		-->
		<pack name="commandline" required="no" preselected="yes">
			<description>Command-line interface (the 'mystic-crypt' console tool)</description>
			<depends packname="executables" />
			<file src="resources/main/doc/mystic-crypt" targetdir="${INSTALL_PATH}" />
			<file src="resources/main/doc/mystic-crypt.bat" targetdir="${INSTALL_PATH}" />
			<!-- mark the unix launcher executable without running it -->
			<executable targetfile="${INSTALL_PATH}/mystic-crypt" stage="never" keep="true" />
		</pack>
		<!--
			The internal plugins contribute their tools to the application's "Plugins" menu. They are
			installed into the user's plugin directory, which is where the application's plugin
			manager looks for them; without this pack the "Plugins" menu stays empty until the user
			adds them by hand through Settings > Plugins > "Install from Zip...".
		-->
		<pack name="plugins" required="no" preselected="yes">
			<description>The internal plugins: obfuscation, checksums, der to pem, console, key generation, certificates, password hashing, key encapsulation demo, post-quantum signatures, key store management and the menu designer</description>
			<depends packname="executables" />
			<singlefile src="../plugins/obfuscation-plugin/build/plugin-dist/obfuscation-plugin-1.0.0.zip"
						target="${USER_HOME}/.config/mystic-crypt-ui/plugins/obfuscation-plugin-1.0.0.zip" />
			<singlefile src="../plugins/checksum-plugin/build/plugin-dist/checksum-plugin-1.0.0.zip"
						target="${USER_HOME}/.config/mystic-crypt-ui/plugins/checksum-plugin-1.0.0.zip" />
			<singlefile src="../plugins/conversion-plugin/build/plugin-dist/conversion-plugin-1.0.0.zip"
						target="${USER_HOME}/.config/mystic-crypt-ui/plugins/conversion-plugin-1.0.0.zip" />
			<singlefile src="../plugins/console-plugin/build/plugin-dist/console-plugin-1.0.0.zip"
						target="${USER_HOME}/.config/mystic-crypt-ui/plugins/console-plugin-1.0.0.zip" />
			<singlefile src="../plugins/keygen-plugin/build/plugin-dist/keygen-plugin-1.0.0.zip"
						target="${USER_HOME}/.config/mystic-crypt-ui/plugins/keygen-plugin-1.0.0.zip" />
			<singlefile src="../plugins/certificate-plugin/build/plugin-dist/certificate-plugin-1.0.0.zip"
						target="${USER_HOME}/.config/mystic-crypt-ui/plugins/certificate-plugin-1.0.0.zip" />
			<singlefile src="../plugins/password-hash-plugin/build/plugin-dist/password-hash-plugin-1.0.0.zip"
						target="${USER_HOME}/.config/mystic-crypt-ui/plugins/password-hash-plugin-1.0.0.zip" />
			<singlefile src="../plugins/kem-demo-plugin/build/plugin-dist/kem-demo-plugin-1.0.0.zip"
						target="${USER_HOME}/.config/mystic-crypt-ui/plugins/kem-demo-plugin-1.0.0.zip" />
			<singlefile src="../plugins/menu-designer-plugin/build/plugin-dist/menu-designer-plugin-1.0.0.zip"
						target="${USER_HOME}/.config/mystic-crypt-ui/plugins/menu-designer-plugin-1.0.0.zip" />
			<singlefile src="../plugins/pqc-signature-plugin/build/plugin-dist/pqc-signature-plugin-1.0.0.zip"
						target="${USER_HOME}/.config/mystic-crypt-ui/plugins/pqc-signature-plugin-1.0.0.zip" />
			<singlefile src="../plugins/keystore-plugin/build/plugin-dist/keystore-plugin-1.0.0.zip"
						target="${USER_HOME}/.config/mystic-crypt-ui/plugins/keystore-plugin-1.0.0.zip" />
		</pack>
	</packs>

</izpack:installation>
