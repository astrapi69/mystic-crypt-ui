#!/bin/bash
# mystic-crypt command-line interface launcher. Runs the CLI entry point from the same application
# jar the desktop app uses (it bundles the mystic-crypt library, which carries the CLI). Pass any
# subcommand and options straight through, e.g.:
#   ./mystic-crypt hash --algorithm argon2id --password-stdin
#   ./mystic-crypt kem --algorithm hybrid
DIR="$(cd "$(dirname "$0")" && pwd)"
exec java -cp "$DIR/mystic-crypt-ui.jar" io.github.astrapi69.mystic.crypt.cli.MysticCryptCli "$@"
