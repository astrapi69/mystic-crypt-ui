#!/bin/bash
# mystic-crypt command-line interface launcher. Runs the application jar's command line, the
# path "java -jar mystic-crypt-ui.jar --cli" takes: the commands of the mystic-crypt library plus
# those the installed plugins contribute. The Java and the flags are the ones start.sh uses:
# find-java.sh, which both source, takes the Java the installer ran on, then the PATH's, 25 or
# newer. The starter resolves its own path, so the symlink the installer puts into ~/.local/bin
# finds the installation from any working directory. Arguments, standard input and the exit code
# of the command pass through unchanged, e.g.:
#   mystic-crypt hash --algorithm argon2id --password-stdin
#   mystic-crypt kem --algorithm hybrid
# When no Java fits, the reason goes to standard error only - a terminal tool opens no dialog -
# and the exit code is non-zero.

# readlink -f is GNU's and macOS 12.3 and newer; a readlink without it refuses the option, and the
# starter then follows the chain of links one step at a time with plain readlink, which every
# system has. Left alone, the path of the link would be taken for the installation's directory.
SELF="$(readlink -f "$0" 2>/dev/null)"
if [ -z "$SELF" ]; then
  SELF=$0
  hops=0
  while [ -L "$SELF" ] && [ "$hops" -lt 40 ]; do
    hops=$((hops + 1))
    target="$(readlink "$SELF")" || break
    case $target in
      /*) SELF=$target ;;
      *) case $SELF in */*) SELF="${SELF%/*}/$target" ;; *) SELF=$target ;; esac ;;
    esac
  done
  case $SELF in */*) ;; *) SELF=./$SELF ;; esac
  # the directory without the ".." and the links the chain went through, as readlink -f gives it
  if directory="$(cd "${SELF%/*}" 2>/dev/null && pwd -P)"; then SELF="$directory/${SELF##*/}"; fi
fi
DIR="${SELF%/*}"

if ! . "$DIR/find-java.sh"; then
  echo "mystic-crypt cannot run: $DIR/find-java.sh is missing. Install mystic-crypt-ui again." >&2
  exit 1
fi

if find_java; then
  exec "$FOUND_JAVA" "${JVM_FLAGS[@]}" -jar "$DIR/mystic-crypt-ui.jar" --cli "$@"
fi

echo "mystic-crypt needs Java $MINIMUM_JAVA or newer and cannot run. Tried:$JAVA_REPORT"$'\n'"Install a Java $MINIMUM_JAVA JDK and run the command again." >&2
exit 1
